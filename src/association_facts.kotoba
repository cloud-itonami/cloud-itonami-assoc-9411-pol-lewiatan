;; The LEWIATAN source catalog, as Kotoba.
;;
;; GENERATED by scripts/gen-kotoba-port.cljs from data/datascript-tx.edn,
;; which src/association/facts.cljc holds as data. Both are the same
;; catalog; this one reaches the Kotoba oracle, wasm and both native ISAs,
;; which the .cljc cannot. Do not hand-edit -- run the generator, and
;; `--check` will tell you if someone did.
;;
;; `:topic` is a SET in the source. A set has no order and `topic` is
;; indexed by position, so the generator uses the order the data file
;; writes. `by-topic-id` answers by name and is unaffected.
;;
;; Parity: test/association_facts_kotoba_parity_test.clj compares every
;; field of every entry against the .cljc, so this file cannot drift from
;; the data without the suite saying so.

(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [a :string] :bool (string=? a "lewiatan"))

(defn entry-count [a :string] :i64 (if (association-covered? a) 10 0))

(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (< i 0) false (< i 10)) false))

(defn entry-field-0 [f :string] [:option :string]
  (cond
    (string=? f "id") (option-some-of [:option :string] "lewiatan.centralny-zwiazek-founding-1919-12-15")
    (string=? f "title") (option-some-of [:option :string] "Centralny Związek Polskiego Przemysłu, Górnictwa, Handlu i Finansów (Lewiatan's pre-war predecessor) founded 15 December 1919")
    (string=? f "association") (option-some-of [:option :string] "lewiatan")
    (string=? f "isic") (option-some-of [:option :string] "9411")
    (string=? f "country") (option-some-of [:option :string] "POL")
    (string=? f "kind") (option-some-of [:option :string] "governance-program")
    (string=? f "url") (option-some-of [:option :string] "https://lewiatan.org/100-lat-lewiatana/")
    (string=? f "url-provenance") (option-some-of [:option :string] "official-lewiatan-org")
    (string=? f "source-article") (option-some-of [:option :string] "100 lat Lewiatana")
    (string=? f "source-quote") (option-some-of [:option :string] "15 grudnia został powołany do życia Centralny Związek Polskiego Przemysłu, Górnictwa, Handlu i Finansów.")
    (string=? f "established-date") (option-some-of [:option :string] "1919-12-15")
    (string=? f "date-precision") (option-some-of [:option :string] "day")
    (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
